{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{assets/fonts/**,assets/reference-library/**/*.jpeg,assets/reference-library/**/*.jpg,assets/reference-library/**/*.png,tests/**,docs/**,examples/**,outputs/**,scripts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.py"
    },
    {
      "source": "/mcp/",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/tool",
      "destination": "/api/index.py"
    },
    {
      "source": "/poster",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/blob-cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "buildCommand": "PYTHONPATH=src python scripts/verify_blob_manifest.py",
  "env": {
    "FROGPT_BLOB_ENABLED": "true",
    "FROGPT_FONT_SOURCE": "blob"
  }
}
