{
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    },
    "api/mcp.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/mcp/",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
