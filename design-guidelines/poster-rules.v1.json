{
  "schemaVersion": "1.0.0",
  "coordinateSystem": "normalized-top-left",
  "units": {
    "relativeToShortSide": "min(canvas.width,canvas.height)",
    "normalized": "fraction-of-axis"
  },
  "rules": [
    {
      "id": "TYPO-001",
      "category": "typography",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 1,
      "unit": "count",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "空白、只有空格、字型不支援且無 fallback 均不得成功渲染",
      "overridePolicy": "never",
      "operator": "typo_001",
      "documentation": "至少 1 個有效文字元素",
      "enforcement": "executable"
    },
    {
      "id": "TYPO-002",
      "category": "typography",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "不可自動刪字、改字、截斷；自動換行可以，必須可回報",
      "overridePolicy": "never",
      "operator": "typo_002",
      "documentation": "保留原文與標點",
      "enforcement": "executable"
    },
    {
      "id": "TYPO-003",
      "category": "typography",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "以實際字型 metrics、換行結果判斷；非單靠 fontSize",
      "overridePolicy": "never",
      "operator": "typo_003",
      "documentation": "glyph bounding box 在文字安全區內",
      "enforcement": "executable"
    },
    {
      "id": "TYPO-004",
      "category": "typography",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 0.1,
      "unit": "relativeToShortSide",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "由字數與空間自動縮放，允許風格覆蓋",
      "overridePolicy": "style",
      "operator": "typo_004",
      "documentation": "headline size 0.07–0.14 × 短邊；初始 0.10",
      "enforcement": "executable",
      "range": {
        "min": 0.07,
        "max": 0.14
      }
    },
    {
      "id": "TYPO-005",
      "category": "typography",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": {
        "secondary": [
          0.3,
          0.5
        ],
        "body": [
          0.18,
          0.34
        ]
      },
      "unit": "relativeToHeadline",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "僅做比例初始範圍；可超出但需記錄",
      "overridePolicy": "style",
      "operator": "typo_005",
      "documentation": "secondary/title 0.30–0.50 × headline；body 0.18–0.34",
      "enforcement": "executable"
    },
    {
      "id": "TYPO-006",
      "category": "typography",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": {
        "headline": [
          0.9,
          1.15
        ],
        "body": [
          1.15,
          1.6
        ]
      },
      "unit": "lineHeightMultiplier",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "以字體實際 metrics 校驗；繁體中文避免過度擠壓",
      "overridePolicy": "style",
      "operator": "typo_006",
      "documentation": "headline lineHeight 0.90–1.15、body 1.15–1.60，倍率",
      "enforcement": "executable"
    },
    {
      "id": "TYPO-007",
      "category": "typography",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": {
        "families": 2,
        "weights": 3
      },
      "unit": "count",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "參考設計可覆蓋，顯示 warning",
      "overridePolicy": "style",
      "operator": "typo_007",
      "documentation": "同張海報字族預設最多 2 組，字重最多 3 種",
      "enforcement": "executable"
    },
    {
      "id": "TYPO-008",
      "category": "typography",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": [
        2,
        4
      ],
      "unit": "count",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "少字海報僅有 headline 也合法；不是強制四種層級",
      "overridePolicy": "style",
      "operator": "typo_008",
      "documentation": "優先使用 2–4 層文字層級",
      "enforcement": "executable"
    },
    {
      "id": "TYPO-009",
      "category": "typography",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "對中英文混排逐 run 量測，fallback 必須實際可用，不能靠瀏覽器未知替換",
      "overridePolicy": "never",
      "operator": "typo_009",
      "documentation": "font glyph coverage + fallback",
      "enforcement": "executable"
    },
    {
      "id": "TYPO-010",
      "category": "typography",
      "severity": "advisory",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/overview",
      "rationale": "不在標點前產生孤行、不隨意拆固定詞組；可允許刻意設計",
      "overridePolicy": "conditional",
      "operator": "typo_010",
      "documentation": "兩行中文標題考慮語意斷行",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "GRID-001",
      "category": "grid-layout",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": "normalized-top-left",
      "unit": "normalized",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "必須可在不同畫板比例換算，負寬高或 NaN 拒絕",
      "overridePolicy": "never",
      "operator": "grid_001",
      "documentation": "座標規格 x/y/w/h 為 0–1 normalized",
      "enforcement": "executable"
    },
    {
      "id": "GRID-002",
      "category": "grid-layout",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "藝術性 bleed 只針對明示可裁切的裝飾素材",
      "overridePolicy": "never",
      "operator": "grid_002",
      "documentation": "重要內容（文字／完整產品主體的保護區）不得超出 canvas",
      "enforcement": "executable"
    },
    {
      "id": "GRID-003",
      "category": "grid-layout",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 0.06,
      "unit": "relativeToShortSide",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "換算為畫布 x/y 軸分別不同的 normalized margin",
      "overridePolicy": "style",
      "operator": "grid_003",
      "documentation": "四周 safe margin = 0.05–0.08 × 短邊，預設 0.06",
      "enforcement": "executable",
      "range": {
        "min": 0.05,
        "max": 0.08
      }
    },
    {
      "id": "GRID-004",
      "category": "grid-layout",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 6,
      "unit": "count",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "依構圖密度選擇，非必須對齊每條格線",
      "overridePolicy": "style",
      "operator": "grid_004",
      "documentation": "4、6 或 12 欄，預設 6 欄",
      "enforcement": "executable",
      "choices": [
        4,
        6,
        12
      ]
    },
    {
      "id": "GRID-005",
      "category": "grid-layout",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 0.025,
      "unit": "relativeToShortSide",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "可用風格 override",
      "overridePolicy": "style",
      "operator": "grid_005",
      "documentation": "gutter = 短邊 0.015–0.035，預設 0.025",
      "enforcement": "executable",
      "range": {
        "min": 0.015,
        "max": 0.035
      }
    },
    {
      "id": "GRID-006",
      "category": "grid-layout",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "以 offset/距離評分，不可強迫主體置中",
      "overridePolicy": "style",
      "operator": "grid_006",
      "documentation": "內容群組共享 key lines；同組可有一致左緣／基線",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "GRID-007",
      "category": "grid-layout",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 0.025,
      "unit": "relativeToShortSide",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "文字間距遵循實際 glyph box，不以看不見的容器框代替",
      "overridePolicy": "style",
      "operator": "grid_007",
      "documentation": "區塊最小間距 = 短邊 0.02；初始 0.025",
      "enforcement": "experimental",
      "range": {
        "min": 0.02,
        "max": 0.025
      },
      "notAutomaticallyTestable": "Tokens/measurements are available, but optical spacing, perceived focus, palette roles and aesthetic quality are not automatically established."
    },
    {
      "id": "GRID-008",
      "category": "grid-layout",
      "severity": "advisory",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "不應以 `center everything` 當 fallback",
      "overridePolicy": "conditional",
      "operator": "grid_008",
      "documentation": "可使用非對稱、偏心及留白構圖",
      "enforcement": "executable"
    },
    {
      "id": "GRID-009",
      "category": "grid-layout",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.carbondesignsystem.com/building-blocks/foundations/2x-grid/overview",
      "rationale": "相同尺寸、字型、素材及 seed 的結果一致",
      "overridePolicy": "never",
      "operator": "grid_009",
      "documentation": "輸出像素座標必須 deterministic",
      "enforcement": "executable"
    },
    {
      "id": "HIER-001",
      "category": "visual-hierarchy",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": "subject",
      "unit": "enum",
      "source": "FroGPT original",
      "rationale": "GPT 根據目的、文字量、reference 選擇；不強制哪個較大",
      "overridePolicy": "style",
      "operator": "hier_001",
      "documentation": "必須指定 `primaryFocus` = subject/headline",
      "enforcement": "experimental",
      "choices": [
        "subject",
        "headline"
      ],
      "notAutomaticallyTestable": "Tokens/measurements are available, but optical spacing, perceived focus, palette roles and aesthetic quality are not automatically established."
    },
    {
      "id": "HIER-002",
      "category": "visual-hierarchy",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 2,
      "unit": "count",
      "source": "FroGPT original",
      "rationale": "可由實驗型 style preset 覆蓋",
      "overridePolicy": "style",
      "operator": "hier_002",
      "documentation": "畫面中明顯競爭的主要焦點預設不超過 2 個",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "HIER-003",
      "category": "visual-hierarchy",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "FroGPT original",
      "rationale": "不要求一定用不同字級，允許粗細與色彩實現",
      "overridePolicy": "style",
      "operator": "hier_003",
      "documentation": "subordinate text 與 primary focus 區分大小、權重或對比",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "HIER-004",
      "category": "visual-hierarchy",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": [
        0.1,
        0.3
      ],
      "unit": "areaRatio",
      "source": "FroGPT original",
      "rationale": "只做密度診斷；不是強制空白面積，背景紋理不算前景佔用",
      "overridePolicy": "style",
      "operator": "hier_004",
      "documentation": "最小可見負空間偏好：10–30% 的非主要內容區域",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "HIER-005",
      "category": "visual-hierarchy",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 0.12,
      "unit": "ratio",
      "source": "FroGPT original",
      "rationale": "以視覺質量估計（面積×對比×顯著性），分數僅做排序，不能宣稱客觀美學",
      "overridePolicy": "style",
      "operator": "hier_005",
      "documentation": "`opticalBalanceTolerance` 預設 0.12",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "HIER-006",
      "category": "visual-hierarchy",
      "severity": "advisory",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "FroGPT original",
      "rationale": "不應以完全幾何對稱代替視覺平衡",
      "overridePolicy": "conditional",
      "operator": "hier_006",
      "documentation": "留白可以不均勻、主體可偏移",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "COLOR-001",
      "category": "color-theory",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
      "rationale": "支援標準 HEX 或既有 renderer 的色彩格式，無效值拒絕",
      "overridePolicy": "never",
      "operator": "color_001",
      "documentation": "所有輸入色碼可解析且在有效色域",
      "enforcement": "executable"
    },
    {
      "id": "COLOR-002",
      "category": "color-theory",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": {
        "normal": 4.5,
        "large": 3.0
      },
      "unit": "contrastRatio",
      "source": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
      "rationale": "預設一般文字 ≥4.5:1、大字 ≥3:1；在非均勻背景按文字占用區採樣，必要時加底板／陰影／改位置",
      "overridePolicy": "never",
      "operator": "color_002",
      "documentation": "重要文字與實際背後區域有可讀性",
      "enforcement": "executable"
    },
    {
      "id": "COLOR-003",
      "category": "color-theory",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": {
        "primary": 1,
        "support": 1,
        "accent": 1,
        "neutral": true
      },
      "unit": "count",
      "source": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
      "rationale": "不強制所有海報都剛好三色；單色／多彩風格可覆蓋",
      "overridePolicy": "style",
      "operator": "color_003",
      "documentation": "初始 1 主色 + 1 輔色 + 1 強調色 + 中性色",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "COLOR-004",
      "category": "color-theory",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": 0.2,
      "unit": "areaRatio",
      "source": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
      "rationale": "只計前景重點色，不對照片像素做簡單面積禁令",
      "overridePolicy": "style",
      "operator": "color_004",
      "documentation": "強調色覆蓋率初始 ≤0.20",
      "enforcement": "experimental",
      "range": {
        "min": 0,
        "max": 0.2
      },
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "COLOR-005",
      "category": "color-theory",
      "severity": "soft",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
      "rationale": "設計模型可調 hue / lightness / saturation，避免照抄整張參考圖",
      "overridePolicy": "style",
      "operator": "color_005",
      "documentation": "可從主體或參考萃取 palette",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Semantic/optical quality is not established by geometric metrics; disabled from objective scoring."
    },
    {
      "id": "COLOR-006",
      "category": "color-theory",
      "severity": "advisory",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
      "rationale": "`background`, `foreground`, `accent`, `support` 等語意 token",
      "overridePolicy": "conditional",
      "operator": "color_006",
      "documentation": "記錄 palette 的來源及色彩角色",
      "enforcement": "experimental",
      "notAutomaticallyTestable": "Tokens/measurements are available, but optical spacing, perceived focus, palette roles and aesthetic quality are not automatically established."
    },
    {
      "id": "COLOR-007",
      "category": "color-theory",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
      "rationale": "透明材質、陰影或文字底色須以實際 composited pixel 計算",
      "overridePolicy": "never",
      "operator": "color_007",
      "documentation": "alpha compositing 後驗證對比",
      "enforcement": "executable"
    },
    {
      "id": "COMP-001",
      "category": "composition",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": [
        "background",
        "subject",
        "typography"
      ],
      "unit": "layers",
      "source": "FroGPT original",
      "rationale": "Background = solid/gradient/image；Subject = user/AI；Typography = 有效文字",
      "overridePolicy": "never",
      "operator": "comp_001",
      "documentation": "Background / Subject / Typography 三者必須有效",
      "enforcement": "executable"
    },
    {
      "id": "COMP-002",
      "category": "composition",
      "severity": "hard",
      "enabled": true,
      "appliesTo": [
        "poster"
      ],
      "default": true,
      "unit": "boolean",
      "source": "FroGPT original",
      "rationale": "不得因 geometry 缺席而要求補圖或報錯",
      "overridePolicy": "never",
      "operator": "comp_002",
      "documentation": "Geometry 可完全沒有",
      "enforcement": "executable"
    },
    {
      "id": "COMP-003",
      "category": "composition",
      "severity": "hard",
      "enabled": true,
